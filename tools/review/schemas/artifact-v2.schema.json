{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclone.dev/schemas/review-artifact-v2.json",
  "title": "CodeClone review contracts",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/review_packet"},
    {"$ref": "#/$defs/review_artifact"}
  ],
  "$defs": {
    "review_packet": {
      "type": "object",
      "required": [
        "packet_version",
        "policy_version",
        "mode",
        "target",
        "change",
        "classification_hints",
        "release",
        "docs_review"
      ],
      "properties": {
        "packet_version": {"const": "2"},
        "policy_version": {"type": "string"},
        "mode": {"enum": ["commit", "range", "release"]},
        "target": {
          "type": "object",
          "required": ["base_sha", "head_sha", "range", "commit_count"],
          "properties": {
            "base_sha": {"type": "string", "minLength": 40},
            "head_sha": {"type": "string", "minLength": 40},
            "range": {"type": "string"},
            "subject": {"type": "string"},
            "commit_count": {"type": "integer", "minimum": 0},
            "merge_base_used": {"type": "boolean"},
            "root_commit_review": {"type": "boolean"}
          }
        },
        "change": {
          "type": "object",
          "required": ["files", "stats", "commits", "surface_hints", "unmapped_paths", "review_scale"],
          "properties": {
            "files": {"type": "array"},
            "stats": {
              "type": "object",
              "required": ["files", "insertions", "deletions"]
            },
            "commits": {"type": "array"},
            "surface_hints": {"type": "object"},
            "unmapped_paths": {"type": "array", "items": {"type": "string"}},
            "review_scale": {
              "type": "object",
              "required": ["large", "decompose_recommended", "reasons"],
              "properties": {
                "large": {"type": "boolean"},
                "decompose_recommended": {"type": "boolean"},
                "reasons": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "classification_hints": {"type": "object"},
        "release": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "activates_extra_vectors": {"type": "array", "items": {"type": "string"}},
            "mandatory_verification_when_touched": {"type": "object"}
          }
        },
        "docs_review": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "note": {"type": "string"}
          }
        },
        "repository": {
          "type": "object",
          "required": ["root", "dirty"],
          "properties": {
            "root": {"type": "string"},
            "dirty": {"type": "boolean"}
          }
        },
        "verification": {
          "type": "object",
          "properties": {
            "commands_reported_by_author": {"type": "array"},
            "ci_status": {"type": "string"}
          }
        }
      }
    },
    "review_artifact": {
      "type": "object",
      "required": [
        "review_contract_version",
        "mode",
        "base_sha",
        "head_sha",
        "verdict",
        "profile",
        "findings",
        "candidate_ledger",
        "test_proof",
        "evidence_limitations"
      ],
      "properties": {
        "review_contract_version": {"const": 2},
        "mode": {"enum": ["commit", "range", "release", "surface"]},
        "base_sha": {"type": "string", "minLength": 40, "maxLength": 64},
        "head_sha": {"type": "string", "minLength": 40, "maxLength": 64},
        "verdict": {
          "enum": ["CLEAN", "CHANGES_REQUIRED", "BLOCKED", "INSUFFICIENT_EVIDENCE"]
        },
        "profile": {"enum": ["economy", "balanced", "thorough"]},
        "findings": {"type": "array"},
        "candidate_ledger": {"type": "array"},
        "test_proof": {
          "type": "object",
          "required": ["contract", "invariants", "failures"],
          "properties": {
            "contract": {"type": "string"},
            "invariants": {"type": "string"},
            "failures": {"type": "string"}
          }
        },
        "review_units": {"type": "array"},
        "unmapped_paths": {"type": "array", "items": {"type": "string"}},
        "evidence_limitations": {"type": "array"}
      }
    }
  }
}
