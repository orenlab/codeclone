{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeclone.dev/schemas/review-packet-v3.json",
  "title": "CodeClone review packet v3",
  "type": "object",
  "required": [
    "packet_version",
    "policy_version",
    "mode",
    "target",
    "routing",
    "change",
    "classification_hints",
    "release",
    "docs_review",
    "verification",
    "incremental",
    "cost_estimate"
  ],
  "properties": {
    "packet_version": {"const": "3"},
    "policy_version": {"type": "string"},
    "mode": {"enum": ["commit", "range", "release"]},
    "target": {
      "type": "object",
      "required": ["base_sha", "head_sha", "range", "commit_count"],
      "properties": {
        "base_sha": {"type": "string", "minLength": 40},
        "head_sha": {"type": "string", "minLength": 40},
        "range": {"type": "string"},
        "subject": {"type": "string"},
        "commit_count": {"type": "integer", "minimum": 0},
        "merge_base_used": {"type": "boolean"},
        "root_commit_review": {"type": "boolean"}
      }
    },
    "repository": {
      "type": "object",
      "required": ["root", "dirty"],
      "properties": {
        "root": {"type": "string"},
        "dirty": {"type": "boolean"}
      }
    },
    "routing": {
      "type": "object",
      "required": ["profile", "profile_reason", "coordinator_model", "decomposed"],
      "properties": {
        "profile": {"enum": ["economy", "balanced", "thorough"]},
        "profile_reason": {"type": "string"},
        "coordinator_model": {"type": "string"},
        "decomposed": {"type": "boolean"}
      }
    },
    "change": {
      "type": "object",
      "required": ["files", "stats", "commits", "surface_hints", "unmapped_paths", "review_scale"],
      "properties": {
        "files": {"type": "array"},
        "stats": {
          "type": "object",
          "required": ["files", "insertions", "deletions"]
        },
        "commits": {"type": "array"},
        "surface_hints": {"type": "object"},
        "unmapped_paths": {"type": "array", "items": {"type": "string"}},
        "review_scale": {
          "type": "object",
          "required": ["large", "decompose_recommended", "reasons"],
          "properties": {
            "large": {"type": "boolean"},
            "decompose_recommended": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "classification_hints": {"type": "object"},
    "release": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "activates_extra_vectors": {"type": "array", "items": {"type": "string"}},
        "mandatory_verification_when_touched": {"type": "object"}
      }
    },
    "docs_review": {
      "type": "object",
      "required": ["mode", "enabled"],
      "properties": {
        "mode": {"enum": ["off", "transitional", "full"]},
        "enabled": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "contract_briefs": {"type": "object"},
    "verification": {
      "type": "object",
      "required": ["plan"],
      "properties": {
        "plan": {"type": "array"},
        "results": {"type": "array"},
        "commands_reported_by_author": {"type": "array"},
        "ci_status": {"type": "string"}
      }
    },
    "incremental": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "from_sha": {"type": "string"},
        "status": {"type": "string"},
        "reason": {"type": "string"},
        "delta_paths": {"type": "array", "items": {"type": "string"}},
        "skipped_units": {"type": "array", "items": {"type": "string"}},
        "reused_units": {"type": "array", "items": {"type": "string"}},
        "review_from": {"type": "string"}
      }
    },
    "cost_estimate": {
      "type": "object",
      "required": ["profile", "coordinator_model", "relative_weight"],
      "properties": {
        "profile": {"type": "string"},
        "coordinator_model": {"type": "string"},
        "decomposed": {"type": "boolean"},
        "relative_weight": {"type": "number"}
      }
    },
    "review_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "primary_surface", "risk", "reviewer_tier", "paths"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^R-[0-9]{3}$"},
          "primary_surface": {"type": "string"},
          "owner": {"type": "string"},
          "risk": {"type": "string"},
          "reviewer_tier": {"type": "string"},
          "skip_recommended": {"type": "boolean"},
          "paths": {"type": "array", "items": {"type": "string"}},
          "activated_vectors": {"type": "array", "items": {"type": "string"}},
          "unit_brief": {"type": "object"}
        }
      }
    }
  }
}
